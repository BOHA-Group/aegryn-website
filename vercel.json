{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",           "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",        "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/en",
      "permanent": false
    },
    {
      "source": "/privacy",
      "destination": "/en/privacy",
      "permanent": true
    },
    {
      "source": "/terms/use",
      "destination": "/en/terms/use",
      "permanent": true
    },
    {
      "source": "/terms/cgv",
      "destination": "/en/terms/cgv",
      "permanent": true
    },
    {
      "source": "/security",
      "destination": "/en/security",
      "permanent": true
    },
    {
      "source": "/help/faq",
      "destination": "/en/help/faq",
      "permanent": true
    },
    {
      "source": "/:locale/blog/glossaire",
      "destination": "/:locale/glossaire",
      "permanent": true
    },
    {
      "source": "/:locale/discover/:slug",
      "destination": "/:locale/blog/:slug",
      "permanent": true
    },
    {
      "source": "/:locale/discover",
      "destination": "/:locale/blog",
      "permanent": true
    },
    {
      "source": "/fr/:path*",
      "has": [{ "type": "host", "value": "boha-group.com" }],
      "destination": "https://aegryn.com/fr/:path*",
      "permanent": true
    },
    {
      "source": "/en/:path*",
      "has": [{ "type": "host", "value": "boha-group.com" }],
      "destination": "https://aegryn.com/en/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "boha-group.com" }],
      "destination": "https://aegryn.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/newsletter",
      "schedule": "0 9 * * 1"
    }
  ]
}
