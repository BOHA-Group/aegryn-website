{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",           "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",        "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "aegryn-website.vercel.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "aegryn-website-3q4zr8lf1-boha-groups-projects.vercel.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(.*)",
      "missing": [{ "type": "host", "value": "aegryn.com" }],
      "has": [{ "type": "host", "value": "(?i).*\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "aegryn-website.vercel.app" }],
      "destination": "https://aegryn.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "aegryn-website-git-main-boha-groups-projects.vercel.app" }],
      "destination": "https://aegryn.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "aegryn-website-3q4zr8lf1-boha-groups-projects.vercel.app" }],
      "destination": "https://aegryn.com/:path*",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/fr/privacy",
      "permanent": true
    },
    {
      "source": "/terms/use",
      "destination": "/fr/terms/use",
      "permanent": true
    },
    {
      "source": "/terms/cgv",
      "destination": "/fr/terms/cgv",
      "permanent": true
    },
    {
      "source": "/security",
      "destination": "/fr/security",
      "permanent": true
    },
    {
      "source": "/help/faq",
      "destination": "/fr/help/faq",
      "permanent": true
    },
    {
      "source": "/:locale/blog/glossaire",
      "destination": "/:locale/glossaire",
      "permanent": true
    },
    {
      "source": "/:locale/discover/:slug",
      "destination": "/:locale/blog/:slug",
      "permanent": true
    },
    {
      "source": "/:locale/discover",
      "destination": "/:locale/blog",
      "permanent": true
    },
    {
      "source": "/fr/:path*",
      "has": [{ "type": "host", "value": "boha-group.com" }],
      "destination": "https://aegryn.com/fr/:path*",
      "permanent": true
    },
    {
      "source": "/en/:path*",
      "has": [{ "type": "host", "value": "boha-group.com" }],
      "destination": "https://aegryn.com/en/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "boha-group.com" }],
      "destination": "https://aegryn.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/newsletter",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/expert-expiry",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/magazine-publish",
      "schedule": "0 * * * *"
    }
  ]
}
